# Discord Authorization Token (required)
# Get it from Discord DevTools > Network > Headers > authorization
UNDISCORD_AUTH_TOKEN=
# Channel ID to delete messages from (required)
UNDISCORD_CHANNEL_ID=
# Your user ID to filter only your messages (optional)
UNDISCORD_AUTHOR_ID=
# Enable dry run mode (optional, default: false)
UNDISCORD_DRY_RUN=false
